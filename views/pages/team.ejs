<style>
    /* GLOBAL PREMIUM THEME */
    body { background-color: #050505; color: white; font-family: 'Inter', sans-serif; overflow-x: hidden; }

    /* HEADER SECTION */
    .team-header {
        text-align: center;
        padding-top: 140px;
        padding-bottom: 80px;
        position: relative;
        z-index: 2;
    }
    .headline {
        font-size: 48px; font-weight: 900; text-transform: uppercase; letter-spacing: 2px;
        margin-bottom: 15px;
        background: linear-gradient(to right, #fff, #aaa);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .highlight { 
        background: linear-gradient(to right, #00f3ff, #0066ff);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        text-shadow: 0 0 30px rgba(0, 243, 255, 0.3);
    }
    .sub-text { color: #888; font-size: 16px; letter-spacing: 1px; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    /* GRID SYSTEM */
    .team-container {
        max-width: 1200px; margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 50px;
        padding: 0 20px 120px 20px;
        position: relative;
        z-index: 2;
    }

    /* PREMIUM CARD DESIGN */
    .team-card {
        background: rgba(20, 20, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 50px 30px;
        text-align: center;
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(20px);
    }

    /* HOVER STATE (NEON GLOW) */
    .team-card:hover {
        transform: translateY(-15px);
        border-color: #00f3ff;
        box-shadow: 0 20px 80px rgba(0, 243, 255, 0.15);
    }
    
    .team-card::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle at top, rgba(0, 243, 255, 0.1), transparent 70%);
        opacity: 0; transition: 0.5s;
    }
    .team-card:hover::before { opacity: 1; }

    /* PROFILE IMAGE */
    .member-img-wrapper {
        width: 140px; height: 140px;
        margin: 0 auto 30px;
        border-radius: 50%;
        padding: 4px;
        background: linear-gradient(135deg, #333, #111);
        position: relative; z-index: 2;
        transition: 0.5s;
    }
    .team-card:hover .member-img-wrapper {
        background: linear-gradient(135deg, #00f3ff, #0066ff);
        box-shadow: 0 0 40px rgba(0, 243, 255, 0.4);
        transform: scale(1.05);
    }
    .member-img {
        width: 100%; height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #050505;
        filter: grayscale(100%) contrast(1.2);
        transition: 0.5s;
    }
    .team-card:hover .member-img {
        filter: grayscale(0%) contrast(1);
    }

    /* TYPOGRAPHY */
    .member-name { 
        font-size: 24px; font-weight: 800; color: white; 
        margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;
        position: relative; z-index: 2;
    }
    .member-role { 
        color: #00f3ff; font-size: 13px; letter-spacing: 2px; 
        text-transform: uppercase; font-weight: 700; margin-bottom: 25px;
        position: relative; z-index: 2;
        display: inline-block; padding: 5px 15px;
        background: rgba(0, 243, 255, 0.1); border-radius: 20px;
    }
    .member-bio { 
        color: #aaa; font-size: 15px; line-height: 1.7; margin-bottom: 30px;
        position: relative; z-index: 2;
    }

    /* SOCIAL ICONS */
    .social-links { display: flex; justify-content: center; gap: 15px; position: relative; z-index: 2; }
    .social-icon {
        width: 40px; height: 40px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.1);
        display: flex; align-items: center; justify-content: center;
        color: white; text-decoration: none;
        transition: 0.3s;
        background: rgba(255,255,255,0.05);
    }
    .social-icon:hover {
        background: #00f3ff; color: #000; border-color: #00f3ff;
        transform: translateY(-3px); box-shadow: 0 5px 20px rgba(0,243,255,0.4);
    }

    /* BACKGROUND FX */
    .bg-glow-1 {
        position: absolute; width: 600px; height: 600px;
        background: #00f3ff; filter: blur(300px); opacity: 0.1;
        top: -10%; left: -10%; z-index: 1; animation: pulse 10s infinite;
    }
    .bg-glow-2 {
        position: absolute; width: 500px; height: 500px;
        background: #0066ff; filter: blur(250px); opacity: 0.08;
        bottom: 0; right: 0; z-index: 1;
    }
    
    @keyframes pulse { 0% { opacity: 0.1; } 50% { opacity: 0.15; } 100% { opacity: 0.1; } }

</style>

<main>
    <div class="fixed top-0 left-0 w-full h-full bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-5 pointer-events-none"></div>

    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="team-header">
        <h1 class="headline">The <span class="highlight">Architects</span></h1>
        <p class="sub-text">Meet the elite minds engineering the future of digital dominance.</p>
    </div>

    <div class="team-container">

        <div class="team-card">
            <div class="member-img-wrapper">
                <img src="https://ui-avatars.com/api/?name=Akhand+Pratap+Singh&background=00f3ff&color=000&size=512&bold=true" alt="Akhand Pratap Singh" class="member-img">
            </div>
            <h3 class="member-name">Akhand Pratap Singh</h3>
            <p class="member-role">Founder & Lead Engineer</p>
            <p class="member-bio">The visionary behind Webglut. Combining raw coding power with strategic design to build scalable digital ecosystems.</p>
            <div class="social-links">
                <a href="https://linkedin.com" target="_blank" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                <a href="https://github.com" target="_blank" class="social-icon"><i class="fab fa-github"></i></a>
                <a href="mailto:contact@webglut.in" class="social-icon"><i class="fas fa-envelope"></i></a>
            </div>
        </div>

        <div class="team-card">
            <div class="member-img-wrapper">
                <img src="https://ui-avatars.com/api/?name=Surya+Bhan&background=111&color=fff&size=512" alt="Surya Bhan" class="member-img">
            </div>
            <h3 class="member-name">Surya Bhan</h3>
            <p class="member-role">Strategic Advisor</p>
            <p class="member-bio">Expert in business operations and client relations. Ensuring Webglut delivers value beyond just code.</p>
            <div class="social-links">
                <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" class="social-icon"><i class="fas fa-briefcase"></i></a>
            </div>
        </div>

        <div class="team-card" style="display: flex; flex-direction: column; justify-content: center;">
            <div class="member-img-wrapper" style="border-style: dashed; border-color: #333;">
                <div style="width:100%; height:100%; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#050505;">
                    <i class="fas fa-plus" style="font-size: 40px; color: #333;"></i>
                </div>
            </div>
            <h3 class="member-name">You?</h3>
            <p class="member-role">Future Legend</p>
            <p class="member-bio">Do you have what it takes to craft digital chaos? We are looking for designers and developers.</p>
            <div class="social-links">
                <a href="/contact" class="social-icon" style="width: auto; padding: 0 25px; border-radius: 50px; font-weight: bold; letter-spacing: 1px;">
                    Apply Now
                </a>
            </div>
        </div>

    </div>
</main>

